let sw       = &x[0..16] in
let port     = &x[16..32] in
let eth_type = &x[32..48] in
let ip_proto = &x[48..56] in
let ip_src   = &x[56..88] in
let ip_dst   = &x[88..120] in
let tcp_dst  = &x[120..136] in
let vlan     = &x[136..148] in
let tenant   = &x[148..150] in
let dscp     = &x[150..156] in
let tagged   = &x[156..157] in

sw ~ 1; eth_type ~ 0x0800;
(
  (ip_dst ~ 10.10.1.0/24; port := 2)
  +
  (ip_dst ~ 10.10.2.0/24; port := 3)
)